# Copy to .env and supply the blank provider/SEC values. Never commit secrets.

# SEC acquisition
SEC_USER_AGENT=

# OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_API_URL=
OPENAI_APP_ID=
OPENAI_USER_ID=
OPENAI_COMPANY_ID=
OPENAI_API_VERSION=
AVA_PROVIDER_TIMEOUT_SECONDS=90
AVA_PROVIDER_MAX_RETRIES=2
AVA_PROVIDER_CIRCUIT_FAILURES=5
AVA_PROVIDER_CIRCUIT_RECOVERY_SECONDS=30

# Pipeline and model
AVA_PIPELINE_MODE=real
AVA_MODEL_DEVICE=cpu
AVA_LLM_MODEL=AZURE_GPT_4o_2024_1120
AVA_LLM_STREAMING=true
AVA_LLM_CONTEXT_WINDOW_TOKENS=32768
AVA_LLM_RESERVED_OUTPUT_TOKENS=4096
AVA_REQUEST_ROUTING_ENABLED=true

# Qdrant
AVA_QDRANT_MODE=primary
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_ALIAS=ava_filing_chunks_current
QDRANT_LOCAL_PATH=
QDRANT_TIMEOUT_SECONDS=30

# PostgreSQL, conversation context, and memory
AVA_POSTGRES_PASSWORD=local-password
AVA_POSTGRES_DSN=postgresql://ava:local-password@127.0.0.1:5432/ava
AVA_CONVERSATION_MODE=single_user
AVA_SINGLE_USER_BOUNDARY_ACKNOWLEDGED=true
AVA_TENANT_ID=local-test
AVA_USER_ID=local-test
AVA_SHORT_TERM_TOKEN_BUDGET=2048
AVA_SUMMARY_TOKEN_BUDGET=768
AVA_LONG_TERM_MEMORY_STORE=qdrant
AVA_LONG_TERM_TOKEN_BUDGET=512
AVA_LONG_TERM_CANDIDATE_K=5
AVA_LONG_TERM_SCORE_THRESHOLD=0.55
AVA_CONVERSATION_RETENTION_DAYS=90

# Uploads
AVA_UPLOADS_ENABLED=true
AVA_UPLOAD_STORE_PATH=data/private/uploads
AVA_UPLOAD_MAX_BODY_BYTES=20971520

# Bounded tools. Calculator remains hard-disabled during Phase 1.
AVA_CALCULATOR_ENABLED=false
AVA_WEB_SEARCH_ENABLED=false
AVA_WEB_SEARCH_PROVIDER=disabled
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com
AVA_WEB_SEARCH_TIMEOUT_SECONDS=8
AVA_WEB_SEARCH_MAX_RESULTS=5
AVA_MAX_TOOL_EXECUTIONS=4
AVA_MAX_WEB_SEARCHES=2

# HTTP, observability, and local UI
AVA_QUERY_MAX_LENGTH=4000
AVA_MAX_BODY_BYTES=16384
AVA_STREAM_TIMEOUT_SECONDS=180
AVA_REQUESTS_PER_MINUTE=60
AVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AVA_JSON_LOGS=false
AVA_LOG_LEVEL=INFO
AVA_OBSERVABILITY_RETENTION_DAYS=30
AVA_HTTP_PORT=8080
AVA_PUBLIC_ORIGIN=http://127.0.0.1:8080

# OIDC (unused in the default single-user showcase boundary)
AVA_OIDC_ISSUER=
AVA_OIDC_CLIENT_ID=
AVA_OIDC_CLIENT_SECRET=
AVA_OIDC_REDIRECT_URI=
AVA_OIDC_TENANT_ID=
AVA_OIDC_TENANT_CLAIM=tenant_id
AVA_OIDC_ALGORITHMS=RS256
AVA_OIDC_SCOPES=openid profile
AVA_OIDC_DISCOVERY_TIMEOUT_SECONDS=5
AVA_OIDC_CLOCK_SKEW_SECONDS=30
AVA_OIDC_ALLOW_INSECURE_HTTP=false
AVA_AUTH_COOKIE_NAME=ava_session
AVA_AUTH_CSRF_COOKIE_NAME=ava_csrf
AVA_AUTH_LOGIN_TTL_SECONDS=300
AVA_AUTH_SESSION_TTL_SECONDS=28800
AVA_AUTH_COOKIE_SECURE=true
AVA_AUTH_COOKIE_SAME_SITE=lax
